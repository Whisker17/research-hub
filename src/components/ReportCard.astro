---
import type { CardData } from "../../lib/site-data.ts";
import T from "./T.astro";

interface Props {
  card: CardData;
  /** 公开站点：标签链接到 /tags/<tag>/；私有索引：标签只是文字 */
  linkTags: boolean;
  /** 私有索引里显示“私有 / 公开”标记 */
  showVisibility?: boolean;
}
const { card, linkTags, showVisibility = false } = Astro.props;
const searchText = `${card.title} ${card.title_en ?? ""} ${card.summary} ${card.summary_en ?? ""} ${card.tags.map((t) => `${t.key} ${t.label}`).join(" ")}`.toLowerCase();
---
<article class="card" data-card data-domain={card.domain} data-tags={card.tags.map((t) => t.key).join(" ")} data-search={searchText}>
  <div class="card-top">
    <span class="domain">{card.domainLabel}</span>
    {showVisibility && card.visibility === "private" && <span class="chip-neutral"><T k="private" /></span>}
    {showVisibility && card.visibility === "public" && <span class="chip-positive"><T k="public" /></span>}
  </div>
  <h2><a href={card.href} data-en-href={card.href_en} data-en={card.title_en}>{card.title}</a></h2>
  <p class="summary" data-en={card.summary_en}>{card.summary}</p>
  {
    card.tags.length > 0 && (
      <div class="tags">
        {card.tags.map((t) => (linkTags ? <a class="tag" href={`/tags/${t.key}/`}>{t.label}</a> : <span class="tag">{t.label}</span>))}
      </div>
    )
  }
  <div class="dates">
    {card.updated !== card.created && <><T k="updated" /> {card.updated} · </>}<T k="created" /> {card.created}
  </div>
</article>
