---
import type { CardData } from "../../lib/site-data.ts";
import { t, type I18nKey } from "../i18n.ts";
import ReportCard from "./ReportCard.astro";
import T from "./T.astro";

interface Props {
  cards: CardData[];
  /** 显示搜索框与 domain / 标签筛选 */
  filters?: boolean;
  domains?: { key: string; label: string }[];
  tags?: { key: string; label: string; count: number }[];
  linkTags: boolean;
  showVisibility?: boolean;
  /** 没有报告时的提示（src/i18n.ts 的键） */
  emptyKey?: I18nKey;
}
const { cards, filters = false, domains = [], tags = [], linkTags, showVisibility = false, emptyKey = "emptyList" } = Astro.props;
---
<section data-rh-list>
  {
    filters && cards.length > 0 && (
      <div class="filters needs-js">
        <input class="search" type="search" placeholder={t("zh", "searchPlaceholder")} aria-label={t("zh", "searchLabel")} data-i18n-attr="placeholder:searchPlaceholder aria-label:searchLabel" data-q />
        {domains.length > 1 && (
          <div class="chip-row" role="group" aria-label={t("zh", "domainGroup")} data-i18n-attr="aria-label:domainGroup">
            <button class="chip" type="button" data-filter="domain" data-value="" aria-pressed="true"><T k="all" /></button>
            {domains.map((d) => (
              <button class="chip" type="button" data-filter="domain" data-value={d.key} aria-pressed="false">{d.label}</button>
            ))}
          </div>
        )}
        {tags.length > 0 && (
          <div class="chip-row" role="group" aria-label={t("zh", "tagGroup")} data-i18n-attr="aria-label:tagGroup">
            {tags.map((t) => (
              <button class="chip" type="button" data-filter="tag" data-value={t.key} aria-pressed="false">
                {t.label}<span class="n">{t.count}</span>
              </button>
            ))}
          </div>
        )}
      </div>
    )
  }
  {cards.length > 0 && <p class="result-count" data-count><T k="nReports" vars={{ n: cards.length }} /></p>}
  {
    cards.length > 0 ? (
      <div class="cards">
        {cards.map((card) => <ReportCard card={card} linkTags={linkTags} showVisibility={showVisibility} />)}
        <p class="empty" data-empty hidden><T k="emptyFilter" /></p>
      </div>
    ) : (
      <p class="empty"><T k={emptyKey} /></p>
    )
  }
</section>
{
  filters && cards.length > 0 && (
    <script is:inline>
      (() => {
        const root = document.querySelector("[data-rh-list]");
        if (!root) return;
        const cards = Array.from(root.querySelectorAll("[data-card]"));
        const q = root.querySelector("[data-q]");
        const count = root.querySelector("[data-count]");
        const empty = root.querySelector("[data-empty]");
        const params = new URLSearchParams(location.search);
        const state = { q: params.get("q") || "", domain: params.get("domain") || "", tag: params.get("tag") || "" };
        const sync = () => {
          for (const b of root.querySelectorAll("[data-filter]")) {
            b.setAttribute("aria-pressed", String(state[b.dataset.filter] === b.dataset.value));
          }
          if (q && q.value !== state.q) q.value = state.q;
        };
        const apply = () => {
          const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
          let n = 0;
          for (const c of cards) {
            const show =
              (!state.domain || c.dataset.domain === state.domain) &&
              (!state.tag || c.dataset.tags.split(" ").includes(state.tag)) &&
              words.every((w) => c.dataset.search.includes(w));
            c.hidden = !show;
            if (show) n++;
          }
          // 计数随语言切换由 Base 的 rhI18n 重新渲染（data-i18n），这里只换键和数字
          const label = count?.firstElementChild;
          if (label) {
            label.dataset.i18n = n === cards.length ? "nReports" : "nOfReports";
            label.dataset.i18nVars = JSON.stringify({ n, total: cards.length });
            label.textContent = window.rhI18n.t(label.dataset.i18n, { n, total: cards.length });
          }
          if (empty) empty.hidden = n !== 0;
          const p = new URLSearchParams();
          for (const k of ["q", "domain", "tag"]) if (state[k]) p.set(k, state[k]);
          history.replaceState(null, "", `${location.pathname}${p.toString() ? `?${p}` : ""}`);
          sync();
        };
        root.addEventListener("click", (e) => {
          const b = e.target.closest("[data-filter]");
          if (!b) return;
          const key = b.dataset.filter;
          // 标签可再次点击取消；领域“全部”的值为空
          state[key] = key === "tag" && state.tag === b.dataset.value ? "" : b.dataset.value;
          apply();
        });
        q?.addEventListener("input", () => {
          state.q = q.value.trim();
          apply();
        });
        apply();
      })();
    </script>
  )
}
