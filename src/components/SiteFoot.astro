---
import { loadConfig } from "../../lib/config.ts";
import type { Nav } from "./SiteHead.astro";
import T from "./T.astro";

interface Props {
  nav: Nav;
}
const { nav } = Astro.props;
---
<footer class="site-foot">
  <div class="site-foot-inner">
    <span class="foot-brand">Research Hub</span>
    {
      nav === "public" && (
        <>
          <a href="/"><T k="footAll" /></a>
          <a href="/archive/"><T k="footArchive" /></a>
          <a href="/tags/"><T k="footTags" /></a>
        </>
      )
    }
    {
      nav === "private" && (
        <>
          <a href="/p/"><T k="navPrivateIndex" /></a>
          <a href="/p/archive/"><T k="footArchive" /></a>
          <a href="/p/tags/"><T k="footTags" /></a>
          <a href={`${loadConfig().publicUrl}/`}><T k="navPublicSite" /></a>
        </>
      )
    }
  </div>
</footer>
