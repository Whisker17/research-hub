---
/**
 * 私有索引：列出全部已发布报告（含私有）。rh build 会把 /p/ 移到私有站点，
 * 公开站点的产物里不存在本页。公开报告链接回公开站点。
 */
import Base from "../../layouts/Base.astro";
import ReportList from "../../components/ReportList.astro";
import T from "../../components/T.astro";
import { t } from "../../i18n.ts";
import { siteView } from "../../../lib/site-data.ts";

const { cards, domains, usedTags } = siteView("private");
---
<Base title={t("zh", "privateIndex")} titleEn={t("en", "privateIndex")} nav="private">
  <h1 class="page-title"><T k="privateIndex" /></h1>
  <p class="page-sub"><T k="taglinePrivate" /></p>
  <ReportList cards={cards} filters domains={domains} tags={usedTags} linkTags={false} showVisibility emptyKey="emptyPublished" />
</Base>
