---
/** 公开月归档 /YYYY/MM/：只有 public + published 报告的创建月份（siteView("public")）。 */
import Base from "../../../layouts/Base.astro";
import MonthPage from "../../../components/MonthPage.astro";
import { monthVars, t } from "../../../i18n.ts";
import { siteView } from "../../../../lib/site-data.ts";

export function getStaticPaths() {
  return siteView("public").months.map((m) => ({ params: { year: m.year, month: m.month }, props: { month: m } }));
}

const { month } = Astro.props;
const ym = monthVars(month.year, month.month);
---
<Base title={t("zh", "month", ym)} titleEn={t("en", "month", ym)}>
  <MonthPage site="public" month={month} />
</Base>
