---
import Base from "../layouts/Base.astro";
import ReportList from "../components/ReportList.astro";
import T from "../components/T.astro";
import { siteView } from "../../lib/site-data.ts";

const { cards, domains, usedTags } = siteView("public");
---
<Base title="Research Hub">
  <h1 class="page-title"><T k="homeTitle" /></h1>
  <p class="page-sub"><T k="tagline" /></p>
  <ReportList cards={cards} filters domains={domains} tags={usedTags} linkTags emptyKey="emptyPublic" />
</Base>
