---
import Base from "../../layouts/Base.astro";
import SiteFoot from "../../components/SiteFoot.astro";
import { siteView } from "../../../lib/site-data.ts";

const list = siteView("public").usedTags;
---
<Base title="标签">
  <div class="crumbs-bar">
    <p class="crumbs"><a href="/">Research Hub</a></p>
    <button class="lang-toggle" type="button" id="rh-lang-toggle" aria-label="Toggle language">English</button>
  </div>
  <h1 class="page-title">标签</h1>
  <p class="page-sub">{list.length} 个标签</p>
  {
    list.length ? (
      <ul class="index-list">
        {list.map((t) => (
          <li><a href={`/tags/${t.key}/`}><span>{t.label}</span><span class="n">{t.count} 篇</span></a></li>
        ))}
      </ul>
    ) : (
      <p class="empty">还没有标签。</p>
    )
  }
  <SiteFoot />
</Base>
