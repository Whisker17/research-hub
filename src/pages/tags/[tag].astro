---
/** 公开标签页：只有被 public + published 报告用到的标签（siteView("public")，ADR 0003 §2、§3）。 */
import Base from "../../layouts/Base.astro";
import TagPage from "../../components/TagPage.astro";
import { t } from "../../i18n.ts";
import { siteView } from "../../../lib/site-data.ts";

export function getStaticPaths() {
  const v = siteView("public");
  return v.usedTags.map((u) => ({ params: { tag: u.key }, props: { tag: v.tag(u.key)! } }));
}

const { tag } = Astro.props;
---
<Base title={t("zh", "tagTitle", { label: tag.label })} titleEn={t("en", "tagTitle", { label: tag.label })} description={tag.description}>
  <TagPage site="public" tag={tag} />
</Base>
