---
import Base from "../../layouts/Base.astro";
import ReportList from "../../components/ReportList.astro";
import SiteFoot from "../../components/SiteFoot.astro";
import { siteView } from "../../../lib/site-data.ts";

export function getStaticPaths() {
  return siteView("public").usedTags.map((t) => ({ params: { tag: t.key }, props: { label: t.label } }));
}

const { tag } = Astro.params;
const { label } = Astro.props;
const cards = siteView("public").cards.filter((c) => c.tags.some((t) => t.key === tag));
---
<Base title={`标签：${label}`}>
  <div class="crumbs-bar">
    <p class="crumbs"><a href="/">Research Hub</a> / <a href="/tags/">标签</a></p>
    <button class="lang-toggle" type="button" id="rh-lang-toggle" aria-label="Toggle language">English</button>
  </div>
  <h1 class="page-title">{label}</h1>
  <p class="page-sub">{cards.length} 篇报告</p>
  <ReportList cards={cards} linkTags />
  <SiteFoot />
</Base>
