---
import Base from "../../layouts/Base.astro";
import ReportList from "../../components/ReportList.astro";
import SiteFoot from "../../components/SiteFoot.astro";
import { siteData, toCard, usedTags } from "../../../lib/site-data.ts";

export function getStaticPaths() {
  const { publicReports, tags } = siteData();
  return usedTags(publicReports, tags).map((t) => ({ params: { tag: t.key }, props: { label: t.label } }));
}

const { tag } = Astro.params;
const { label } = Astro.props;
const { publicReports, tags } = siteData();
const cards = publicReports.filter((r) => r.meta.tags.includes(tag)).map((r) => toCard(r, tags));
---
<Base title={`标签：${label}`}>
  <p class="crumbs"><a href="/">Research Hub</a> / <a href="/tags/">标签</a></p>
  <h1 class="page-title">{label}</h1>
  <p class="page-sub">{cards.length} 篇报告</p>
  <ReportList cards={cards} linkTags />
  <SiteFoot />
</Base>
