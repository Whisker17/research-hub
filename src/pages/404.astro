---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import { t } from "../i18n.ts";
---
<Base title={t("zh", "notFound")} titleEn={t("en", "notFound")} nav="none">
  <h1 class="page-title"><T k="notFoundTitle" /></h1>
  <p class="page-sub"><T k="notFoundSub" /></p>
  <p><a href="/"><T k="notFoundBack" /></a></p>
</Base>
