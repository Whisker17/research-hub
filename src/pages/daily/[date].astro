---
/** /daily/<date>/（WHI-1936）：一天的推荐。 */
import Base from "../../layouts/Base.astro";
import DailyDay from "../../components/DailyDay.astro";
import T from "../../components/T.astro";
import { dailyCardHash, dailyDays } from "../../daily.ts";
import { t } from "../../i18n.ts";
import type { PublicDay } from "../../../lib/daily.ts";

export function getStaticPaths() {
  return dailyDays().map((day) => ({ params: { date: day.date }, props: { day } }));
}

const { day } = Astro.props as { day: PublicDay };
---
<Base title={t("zh", "dayTitle", { date: day.date })} titleEn={t("en", "dayTitle", { date: day.date })} description={t("zh", "dailySub")}>
  <meta slot="head" name="rh-daily-hash" content={dailyCardHash(day.date)} />
  <p class="crumbs"><a href="/daily/"><T k="navDaily" /></a></p>
  <h1 class="page-title"><T k="dailyTitle" /></h1>
  <DailyDay day={day} />
</Base>
